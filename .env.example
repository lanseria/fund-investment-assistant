NUXT_DB_URL=
NUXT_STRATEGY_API_URL=

# ====================================================================
# 调度器总开关 (DISABLE_SCHEDULER)
# --------------------------------------------------------------------
# 控制是否启用所有定时任务（Nitro cron）以及市场轮询（60s 大盘指数）。
# - 开发模式 (NODE_ENV=development): 默认【禁用】，本地 dev 不会触发任何定时任务，
#   避免干扰线上数据库或频繁请求外部接口。
# - 生产模式: 默认【启用】。
# 显式设置可覆盖默认行为:
#   DISABLE_SCHEDULER=true   强制禁用（生产临时停服时可用）
#   DISABLE_SCHEDULER=false  强制启用（开发时临时验证定时任务）
DISABLE_SCHEDULER=

# ====================================================================
# 定时任务 Cron 表达式
# --------------------------------------------------------------------
# 单个任务留空即可禁用该任务。调度器总开关禁用时，以下 cron 均不生效。
# 更多信息: https://crontab.guru/
# 同步基金历史净值 (默认: 每天 02:00)
CRON_FUND_SYNC_HISTORY=
# 同步盘中估值 (默认: 交易日 09:00-15:00 每半小时)
CRON_FUND_SYNC_ESTIMATE=
# 每日执行策略分析任务 (默认: 每天早上 06:00)
CRON_FUND_RUN_STRATEGIES='0 6 * * *'

# Redis 连接配置
NUXT_REDIS_HOST="127.0.0.1"
NUXT_REDIS_PASSWORD=""

# AI 模型
NUXT_OPEN_ROUTER_API_KEY=
NUXT_OPEN_ROUTER_BASE_URL=https://openrouter.ai/api/v1